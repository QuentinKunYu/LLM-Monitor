{
  "name": "llm-brand-experiment",
  "version": "1.0.0",
  "description": "Interactive web application for context-free LLM brand recommendation experiments. Measures BRP@K and MRR for every observed brand.",
  "main": "server.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QuentinKunYu/LLM-Monitor.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "node --test",
    "check": "npm test && npm run test:followup-reasons && npm run test:study3-needs",
    "test:data-cleaning": "node scripts/test-data-cleaning.js",
    "test:followup-reasons": "node scripts/check-followup-reasons.js",
    "clean:export": "node scripts/rebuild-export-from-state.js",
    "test:study3-fixture": "node scripts/check-study3-test-data.js",
    "test:study3-needs": "node scripts/check-study3-needs-prompts.js",
    "build:browser-prompts": "node scripts/build-browser-prompt-defaults.js",
    "run:study3-needs": "node scripts/run-needs-based-prompts.js",
    "export:study3-simplified": "node scripts/export-study3-simplified.js",
    "test:study2b-fixture": "node scripts/check-study2b-test-data.js",
    "examples:study2b-prompts": "node scripts/build-study2b-prompt-examples.js"
  },
  "dependencies": {
    "express": "^4.21.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "csv-parse": "^5.5.3",
    "csv-stringify": "^6.4.5",
    "openai": "^4.70.0",
    "@anthropic-ai/sdk": "^0.32.0",
    "@google/generative-ai": "^0.21.0"
  },
  "overrides": {
    "qs": "6.16.0"
  }
}
